NODE_ENV=production
PORT=3000

# Postgres
DB_HOST=postgres
DB_PORT=5432
DB_NAME=realtx
DB_USER=root
DB_PASSWORD=change-me

# TypeORM: sync только для локальной разработки, в проде выключено
DB_SYNC=false
DB_MIGRATIONS_RUN=true

# JWT
JWT_ACCESS_SECRET=change-me-long-random
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
COOKIE_DOMAIN=.realtx.online
COOKIE_SECURE=true

# Frontend
FRONTEND_URL=https://realtx.online

# CORS — список через запятую, все origin-ы с которых фронт стучит на api
CORS_ORIGINS=https://realtx.online,https://www.realtx.online

# Resend (email)
RESEND_API_KEY=
MAIL_FROM=noreply@realtx.online
MAIL_FROM_NAME=RealtX

# Firebase (телефон-логин)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Парсер-агент на ноуте: этот же токен пропиши в realtx-parser-agent/.env
INTERNAL_INGEST_TOKEN=change-me-long-random-token

# AdminJS
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=admin
ADMIN_COOKIE_SECRET=change-me-32-chars-min
